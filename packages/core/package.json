{
  "name": "@boxhaggle/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared BOXHAGGLE game rules, commit-reveal, dialogue, zod schemas and event types.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
