# BOXHAGGLE merchant (The Broker). Placeholder values only. Never commit real values.
NODE_ENV=development
PORT=8787
# Bind address. Keep loopback when self-hosted: the local cloudflared is the only public path.
HOST=127.0.0.1
# Public https origin of this service. x402 resource URLs are built from it.
PUBLIC_BASE_URL=http://localhost:8787
# Exact origin(s) of the spectator web app, comma separated. CORS allowlist.
WEB_ORIGIN=http://localhost:5173
# Merchant API key, at least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Store the same value as a PayBox secret credential (agent) and as a brokered
# X-Merchant-Key header in the PayBox developer portal (plugin).
MERCHANT_API_KEY=replace-with-a-random-32-plus-character-value
# Payment rails in preference order: solana, base
X402_NETWORKS=solana,base
# Where payments land. Use wallets you control. Leave a rail empty to disable it.
PAYTO_SOLANA=
PAYTO_BASE=
# http = real facilitator (required in production). local = in-process EVM checks, no settlement (dev only).
FACILITATOR_MODE=http
X402_FACILITATOR_URL=https://facilitator.payai.network
X402_FACILITATOR_TOKEN=
# Haggling fee per counter-offer, atomic USDC (10000 = 0.01 USDC).
OFFER_FEE_ATOMIC=10000
SESSION_TTL_MINUTES=60
PAYMENT_TIMEOUT_SECONDS=300
# Client IP for rate limits. Set at most one.
# 1 behind a local cloudflared: use CF-Connecting-IP, trusted only from a loopback peer.
TRUST_CF_CONNECTING_IP=0
# 1 behind Railway's proxy (alternate deploy): use X-Forwarded-For.
TRUST_PROXY=0
LOG_LEVEL=info
