{
  "name": "@boxhaggle/plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BOXHAGGLE hosted PayBox marketplace plugin (MCP server bundled to dist/plugin.mjs).",
  "scripts": {
    "dev": "tsx src/plugin.ts",
    "build": "esbuild src/plugin.ts --bundle --platform=node --format=esm --target=node24 --minify --legal-comments=none --outfile=dist/plugin.mjs",
    "typecheck": "tsc --noEmit",
    "conformance": "node scripts/conformance.mjs",
    "test": "vitest run",
    "test:conformance": "node scripts/test.mjs"
  },
  "dependencies": {
    "@boxhaggle/core": "0.1.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.2"
  }
}
