# BOXHAGGLE agent. Placeholder values only. Never commit real values.
# The merchant key is NOT here: the agent fetches it from PayBox request_secret.

# PayBox headless auth (docs.paybox.sh/sdk-cli "Headless and CI"). Matched pair:
# create an agent in the PayBox app (pbx_live_ key, shown once), then pair a
# signing key with `paybox connect` under that same key.
PAYBOX_API_URL=https://api.paybox.sh
PAYBOX_API_KEY=pbx_live_replace_me
PAYBOX_SIGNING_KEY=pbxk1.replace_me

# Must equal the merchant's PUBLIC_BASE_URL (the agent refuses to send the key elsewhere).
MERCHANT_URL=http://localhost:8787
ITEM_ID=brass-compass
# Hard cap on fees plus checkout for one run, in USD.
SPEND_CAP_USD=3

# Optional: pick credentials explicitly (ids from list_credentials).
WALLET_CREDENTIAL_ID=
SECRET_CREDENTIAL_ID=
# token-then-raw shows the scoped secret_token first, then uses raw for egress.
SECRET_MODE=token-then-raw
# Card path stays off: no processor-hosted charger exists (docs/RECON.md section 4).
CARD_PATH=off

# Optional payTo pins: refuse any requirement that pays someone else.
EXPECT_PAYTO_SOLANA=
EXPECT_PAYTO_BASE=
# Optional: Solana signature of a completed MoonPay checkout, for verify_solana_balance.
BUY_TX_SIGNATURE=

APPROVAL_WAIT_SECONDS=600
FUNDING_WAIT_SECONDS=900
ACCOUNT_WAIT_SECONDS=300
RELAY=on

# Replay (--mock) only: must equal the local merchant's MERCHANT_API_KEY.
MOCK_MERCHANT_KEY=
MOCK_PACE_MS=700
